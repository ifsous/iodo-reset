# ============================================================
# .env.local — IODO RESET App
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite .env.local no git
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Settings > API > anon public (segura para o browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Settings > API > service_role (NUNCA exponha no frontend)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Anthropic Claude API ──────────────────────────────────────
# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Stripe ───────────────────────────────────────────────────
# dashboard.stripe.com > Developers > API Keys
# Use sk_test_ durante desenvolvimento
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
